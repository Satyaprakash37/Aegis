POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aegis
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/aegis
# Generate a secure key via: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters. Default/weak keys will be rejected at startup.
SECRET_KEY=change_me_to_a_cryptographically_secure_random_key_min_32_chars
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NVD_API_KEY=
# Subfinder API Keys (Optional - Free tiers available for VirusTotal & SecurityTrails)
SUBFINDER_VIRUSTOTAL_KEY=
SUBFINDER_SECURITYTRAILS_KEY=
# Metasploit RPC Daemon (AEGIS v2.0 Attack Lab)
MSF_RPC_PASSWORD=generate_a_secure_token_for_msfrpcd_min_16_chars
# AI Operations Copilot (AEGIS v2.0 Phase R1 - Google Gemini API Key from aistudio.google.com)
GEMINI_API_KEY=
COPILOT_MODEL=gemini-2.0-flash
