POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aegis
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/aegis
# Generate a secure key via: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters. Default/weak keys will be rejected at startup.
SECRET_KEY=change_me_to_a_cryptographically_secure_random_key_min_32_chars
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NVD_API_KEY=
